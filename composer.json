{
    "name": "yaleksandr89/telegram-vacancy-monitor",
    "description": "PHP application for AI-assisted screening of job vacancies submitted through a Telegram bot.",
    "homepage": "https://github.com/yaleksandr89/telegram-vacancy-monitor",
    "keywords": [
        "telegram",
        "vacancies",
        "php",
        "cli"
    ],
    "authors": [
        {
            "name": "Александр Юрченко",
            "email": "y.aleksandr89@yandex.ru",
            "homepage": "https://github.com/yaleksandr89",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/yaleksandr89/telegram-vacancy-monitor/issues",
        "source": "https://github.com/yaleksandr89/telegram-vacancy-monitor",
        "forum": "https://github.com/yaleksandr89/telegram-vacancy-monitor/discussions",
        "security": "https://github.com/yaleksandr89/telegram-vacancy-monitor/security/policy"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://boosty.to/backendbezpafosa"
        },
        {
            "type": "other",
            "url": "https://sponsr.ru/backendbezpafosa/"
        }
    ],
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "autoload": {
        "psr-4": {
            "Yaleksandr\\TelegramVacancyMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yaleksandr\\TelegramVacancyMonitor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php tests/InboxSmoke.php",
            "@php tests/BotApiSmoke.php",
            "@php tests/WebhookManagementSmoke.php",
            "@php tests/BotRunnerSmoke.php",
            "@php tests/AiAnalysisSmoke.php",
            "@php tests/AnalysisRecoverySmoke.php",
            "@php tests/WebhookWorkerSmoke.php",
            "@php tests/PlatformSmoke.php"
        ],
        "lint": "@php tests/Lint.php",
        "check": [
            "@composer validate --no-check-publish",
            "@lint",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
