{
    "name": "yaleksandr89/telegram-vacancy-monitor",
    "description": "Консольное PHP-приложение для мониторинга Telegram-каналов с вакансиями.",
    "type": "project",
    "keywords": [
        "telegram",
        "vacancies",
        "php",
        "cli"
    ],
    "authors": [
        {
            "name": "Александр Юрченко",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/yaleksandr89/telegram-vacancy-monitor/issues",
        "source": "https://github.com/yaleksandr89/telegram-vacancy-monitor"
    },
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "autoload": {
        "psr-4": {
            "Yaleksandr\\TelegramVacancyMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yaleksandr\\TelegramVacancyMonitor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php tests/InboxSmoke.php",
            "@php tests/BotApiSmoke.php",
            "@php tests/BotRunnerSmoke.php",
            "@php tests/AiAnalysisSmoke.php",
            "@php tests/AnalysisRecoverySmoke.php"
        ],
        "lint": "find bin src tests -type f -name '*.php' -print0 | xargs -0 -n1 \"$PHP_BINARY\" -l",
        "check": [
            "@composer validate --no-check-publish",
            "@lint",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
